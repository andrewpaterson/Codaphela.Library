//Allocation and placement new.  new Type, new Type[count], delete and delete[] call the global operators below
//(defined in new.cpp, over malloc and free); the generator makes placement new itself: new(pv) Class constructs
//at pv.
#ifndef __LIBC65_NEW__
#define __LIBC65_NEW__
#include <stddef.h>


void*	operator new(size_t uiBytes);
void*	operator new[](size_t uiBytes);
void	operator delete(void* pv) noexcept;
void	operator delete[](void* pv) noexcept;
inline void*	operator new(size_t uiBytes, void* pv) noexcept { return pv; }
inline void*	operator new[](size_t uiBytes, void* pv) noexcept { return pv; }


#endif // __LIBC65_NEW__
